# Stribog – nastavenia pre docker compose (skopíruj ako .env)

# doména, na ktorej bude appka (Caddy pre ňu automaticky vybaví HTTPS)
DOMAIN=stribog.example.sk

# VOLITEĽNÉ: čítanie súpisu z fotiek cez AI (Anthropic API, console.anthropic.com → API Keys).
# Ak necháš prázdne, tlačidlo sa skryje a zvyšok aplikácie funguje normálne.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
